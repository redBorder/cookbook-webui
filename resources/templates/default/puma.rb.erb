#######################################################
## Generated by Chef for <%= node["hostname"] %>
#######################################################

directory '/var/www/rb-rails'
environment 'production'

# What ports/sockets to listen on, and what options for them
bind 'tcp://0.0.0.0:8001?backlog=1024&low_latency=true'

# How many worker processes, and how many requests each one serves at the same
# time (database.yml has a pool of at least that many connections)
workers <%= @workers %>
threads <%= @threads %>, <%= @threads %>

# Every worker loads the application itself, as unicorn did with
# preload_app false (puma preloads it by default when there are several workers)
preload_app! false

# Loading the application takes about a minute on a manager. Puma kills a
# worker that has not booted in 60 seconds (unicorn had no such limit)
worker_boot_timeout 600
